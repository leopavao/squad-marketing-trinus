# === Segredos — NUNCA versionar ===
.env
.env.local
*.key
*.token

# === Arquivos pesados / binários (não subir pro GitHub) ===
# Imagens
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tiff
*.ico

# Exceção controlada: somente logos oficiais da marca
!**/design-system/assets/logos/*.png

# Exceção controlada: locação fotográfica das referências, em versão reduzida.
# Sem ela nenhum agente consegue renderizar e VER a peça aprovada, que foi a
# causa da reprovação de 2026-08-10. Máximo 1400px no lado maior e 500 KB.
!marca/referencias/*/assets/locacao-*.jpg

# Vídeo
*.mp4
*.mov
*.avi
*.mkv
*.webm
# Áudio
*.wav
*.mp3
*.m4a
*.aac
*.flac
# Documentos, design e pacotes binários
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.psd
*.ai
*.sketch
*.fig
*.zip
*.tar
*.gz

# === Dumps brutos de scraping (podem conter dados pessoais) ===
**/output/radar/*-raw.json

# === Ruído de sistema ===
.DS_Store
**/.DS_Store
